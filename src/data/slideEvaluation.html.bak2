<section class="slide" data-screen-label="08 Evaluation" style="display:flex; flex-direction:column;">
  <div class="eyebrow" style="margin-bottom:20px;">Evaluation</div>
  <h2 class="section" style="font-size:74px;">Evaluation <em>without production labels.</em></h2>
  <div class="serif" style="font-style:italic; font-size:30px; color:var(--muted); margin-top:12px; max-width:1500px;">
    A small AI-assisted, manually checked reference set for directional model selection.
  </div>

  <!-- Main content area -->
  <div style="margin-top:36px; display:flex; flex-direction:column; gap:20px;">

    <!-- ===== TOP: single Reference set card ===== -->
    <div class="card" style="padding:24px 36px; display:flex; flex-direction:column; gap:14px;">
      <div style="font-size:20px; letter-spacing:.18em; text-transform:uppercase; color:var(--terracotta-2); font-weight:700;">Reference set</div>
      <div style="font-family:'Newsreader', serif; font-size:40px; font-weight:500; color:var(--ink); line-height:1.1;">
        24 reports &nbsp;&mdash;&nbsp; 3 difficulty groups
      </div>
      <!-- Flow row -->
      <div style="display:flex; align-items:center; gap:16px; margin-top:6px;">
        <!-- Step 1 -->
        <div style="display:flex; align-items:center; gap:10px;">
          <svg width="28" height="28" viewBox="0 0 28 28" fill="none" style="flex:0 0 auto;">
            <rect x="2" y="6" width="24" height="16" rx="3" stroke="#b0a898" stroke-width="1.8"/>
            <circle cx="14" cy="14" r="4" stroke="#b0a898" stroke-width="1.8"/>
          </svg>
          <span style="font-size:22px; color:var(--ink-2);">LLM suggests</span>
        </div>
        <!-- Arrow -->
        <svg width="28" height="20" viewBox="0 0 28 20" fill="none" style="flex:0 0 auto;">
          <path d="M2 10 H22 M16 4 L24 10 L16 16" stroke="#b0a898" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        <!-- Step 2 -->
        <div style="display:flex; align-items:center; gap:10px;">
          <svg width="28" height="28" viewBox="0 0 28 28" fill="none" style="flex:0 0 auto;">
            <circle cx="14" cy="10" r="5" stroke="#b0a898" stroke-width="1.8"/>
            <path d="M4 24 C4 18 24 18 24 24" stroke="#b0a898" stroke-width="1.8" stroke-linecap="round"/>
          </svg>
          <span style="font-size:22px; color:var(--ink-2);">human checks</span>
        </div>
        <!-- Arrow -->
        <svg width="28" height="20" viewBox="0 0 28 20" fill="none" style="flex:0 0 auto;">
          <path d="M2 10 H22 M16 4 L24 10 L16 16" stroke="#b0a898" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        <!-- Step 3 -->
        <div style="display:flex; align-items:center; gap:10px;">
          <svg width="28" height="28" viewBox="0 0 28 28" fill="none" style="flex:0 0 auto;">
            <rect x="4" y="4" width="20" height="20" rx="2" stroke="#b0a898" stroke-width="1.8"/>
            <path d="M9 14 L13 18 L20 10" stroke="#b0a898" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          <span style="font-size:22px; color:var(--ink-2);">final label</span>
        </div>
      </div>
    </div>

    <!-- ===== MIDDLE: compact example case ===== -->
    <div class="case" style="padding:14px 36px; display:flex; align-items:center; gap:48px;">
      <div style="flex:1.4;">
        <div class="tag" style="font-size:20px;">Example case</div>
        <blockquote style="font-size:26px; margin-top:4px;">&ldquo;BG reached over 600&nbsp;mg/dL &hellip; cannula dislodged &hellip; nausea and vomiting.&rdquo;</blockquote>
      </div>
      <div style="width:1px; align-self:stretch; background:var(--line);"></div>
      <div style="flex:1; display:flex; flex-direction:column; gap:10px;">
        <div>
          <div style="font-size:20px; letter-spacing:.16em; text-transform:uppercase; color:var(--muted); font-weight:600;">Expected PT</div>
          <div style="font-family:'Newsreader', serif; font-size:30px; font-weight:600; font-style:italic; color:var(--terracotta-2); line-height:1.1; margin-top:4px;">Hyperglycaemia</div>
        </div>
        <div>
          <div style="font-size:20px; letter-spacing:.16em; text-transform:uppercase; color:var(--muted); font-weight:600;">Why tricky</div>
          <div style="font-size:22px; color:var(--ink-2); line-height:1.35; margin-top:4px;">device + outcome in one text</div>
        </div>
      </div>
    </div>

    <!-- ===== METRICS: vertical stack ===== -->
    <div style="display:flex; flex-direction:column; gap:10px;">

      <div class="card" style="padding:14px 28px; display:flex; align-items:center; gap:22px;">
        <div style="font-family:'JetBrains Mono', monospace; font-size:30px; font-weight:700; color:var(--terracotta-2); line-height:1; flex:0 0 120px;">R@100</div>
        <div style="width:1px; align-self:stretch; background:var(--line);"></div>
        <div style="font-size:22px; color:var(--ink-2);">In candidate pool?</div>
      </div>

      <div class="card" style="padding:14px 28px; display:flex; align-items:center; gap:22px;">
        <div style="font-family:'JetBrains Mono', monospace; font-size:30px; font-weight:700; color:var(--terracotta-2); line-height:1; flex:0 0 120px;">soft@5</div>
        <div style="width:1px; align-self:stretch; background:var(--line);"></div>
        <div style="font-size:22px; color:var(--ink-2);">Usable in top 5?</div>
      </div>

      <div class="card" style="padding:14px 28px; display:flex; align-items:center; gap:22px;">
        <div style="font-family:'JetBrains Mono', monospace; font-size:30px; font-weight:700; color:var(--terracotta-2); line-height:1; flex:0 0 120px;">p@1</div>
        <div style="width:1px; align-self:stretch; background:var(--line);"></div>
        <div style="font-size:22px; color:var(--ink-2);">Exact at rank 1?</div>
      </div>

    </div>
  </div>

  <!-- Bottom dark conclusion bar -->
  <div class="concl">
    &#10132; <em style="font-style:italic; color:var(--terracotta-2); font-weight:700;">Reference set</em> &mdash; a controlled basis to compare models.
  </div>

  <div class="ftr">
    <div>SENTINEL<em style="font-style:italic; color:var(--terracotta-2);">AI</em> &nbsp;|&nbsp; 03 JUN 2026</div>
    <div class="rule"></div>
    <div style="color:var(--terracotta-2);">9 / 13</div>
  </div>
</section>
