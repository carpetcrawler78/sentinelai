<section class="slide" data-screen-label="08 Evaluation" style="display:flex; flex-direction:column;">
  <div class="eyebrow" style="margin-bottom:20px;">Evaluation</div>
  <h2 class="section" style="font-size:74px;">Evaluation <em>without production labels.</em></h2>
  <div class="serif" style="font-style:italic; font-size:30px; color:var(--muted); margin-top:12px; max-width:1500px;">
    A small AI-assisted, manually checked reference set for directional model selection.
  </div>

  <!-- Main content area (leaves room for the bottom conclusion bar) -->
  <div style="margin-top:36px; display:flex; flex-direction:column; gap:22px;">

    <!-- ===== TOP ROW: three explanatory boxes ===== -->
    <div style="display:flex; align-items:stretch; gap:26px;">

      <!-- Box 1 · Reference set -->
      <div class="card" style="flex:1; padding:24px 30px; display:flex; flex-direction:column;">
        <div style="font-size:20px; letter-spacing:.18em; text-transform:uppercase; color:var(--terracotta-2); font-weight:700;">Reference set v1</div>
        <div style="font-family:'Newsreader', serif; font-size:36px; font-weight:500; color:var(--ink); line-height:1.1; margin-top:12px;">24 device incident reports</div>
        <div style="height:1px; background:var(--line); margin:14px 0;"></div>
        <div style="font-size:23px; color:var(--ink-2); line-height:1.4;">3 device groups &nbsp;&middot;&nbsp; simple &middot; moderate &middot; difficult</div>
      </div>

      <!-- Box 2 · Labeling approach -->
      <div class="card" style="flex:1; padding:24px 30px; display:flex; flex-direction:column;">
        <div style="font-size:20px; letter-spacing:.18em; text-transform:uppercase; color:var(--terracotta-2); font-weight:700;">Labeling approach</div>
        <ul class="dash" style="margin-top:14px;">
          <li style="font-size:25px;">LLM proposes <b>PT + rationale</b></li>
          <li style="font-size:25px;">Manual plausibility check</li>
          <li style="font-size:25px;">Final reference label per case</li>
        </ul>
      </div>

      <!-- Box 3 · Interpretation -->
      <div class="card" style="flex:1; padding:24px 30px; display:flex; flex-direction:column;">
        <div style="font-size:20px; letter-spacing:.18em; text-transform:uppercase; color:var(--terracotta-2); font-weight:700;">Interpretation</div>
        <ul class="dash" style="margin-top:14px;">
          <li style="font-size:25px;">Prototype evaluation</li>
          <li style="font-size:25px;">Directional model selection</li>
          <li style="font-size:25px;"><b>Not</b> production validation</li>
        </ul>
      </div>
    </div>

    <!-- ===== MIDDLE: wider example box ===== -->
    <div class="case" style="padding:20px 36px; display:flex; align-items:center; gap:48px;">
      <div style="flex:1.4;">
        <div class="tag" style="font-size:20px;">Example case</div>
        <blockquote style="font-size:28px; margin-top:4px;">&ldquo;BG reached over 600&nbsp;mg/dL &hellip; cannula dislodged &hellip; nausea and vomiting.&rdquo;</blockquote>
      </div>
      <div style="width:1px; align-self:stretch; background:var(--line);"></div>
      <div style="flex:1; display:flex; flex-direction:column; gap:12px;">
        <div>
          <div style="font-size:20px; letter-spacing:.16em; text-transform:uppercase; color:var(--muted); font-weight:600;">Expected PT</div>
          <div style="font-family:'Newsreader', serif; font-size:32px; font-weight:600; font-style:italic; color:var(--terracotta-2); line-height:1.1; margin-top:4px;">Hyperglycaemia</div>
        </div>
        <div>
          <div style="font-size:20px; letter-spacing:.16em; text-transform:uppercase; color:var(--muted); font-weight:600;">Why tricky</div>
          <div style="font-size:23px; color:var(--ink-2); line-height:1.35; margin-top:4px;">Device issue + clinical outcome in one narrative</div>
        </div>
      </div>
    </div>

    <!-- ===== BOTTOM ROW: three compact metric cards ===== -->
    <div style="display:flex; align-items:stretch; gap:26px;">

      <div class="card" style="flex:1; padding:18px 28px; display:flex; align-items:center; gap:22px;">
        <div style="font-family:'JetBrains Mono', monospace; font-size:34px; font-weight:700; color:var(--terracotta-2); line-height:1; flex:0 0 auto;">R@100</div>
        <div style="width:1px; align-self:stretch; background:var(--line);"></div>
        <div style="font-size:22px; color:var(--ink-2); line-height:1.3;">Reference term in candidate pool?</div>
      </div>

      <div class="card" style="flex:1; padding:18px 28px; display:flex; align-items:center; gap:22px;">
        <div style="font-family:'JetBrains Mono', monospace; font-size:34px; font-weight:700; color:var(--terracotta-2); line-height:1; flex:0 0 auto;">soft@5</div>
        <div style="width:1px; align-self:stretch; background:var(--line);"></div>
        <div style="font-size:22px; color:var(--ink-2); line-height:1.3;">Clinically usable term in top&nbsp;5?</div>
      </div>

      <div class="card" style="flex:1; padding:18px 28px; display:flex; align-items:center; gap:22px;">
        <div style="font-family:'JetBrains Mono', monospace; font-size:34px; font-weight:700; color:var(--terracotta-2); line-height:1; flex:0 0 auto;">p@1</div>
        <div style="width:1px; align-self:stretch; background:var(--line);"></div>
        <div style="font-size:22px; color:var(--ink-2); line-height:1.3;">Exact reference term at rank&nbsp;1?</div>
      </div>
    </div>
  </div>


  <!-- Bottom dark conclusion bar -->
  <div class="concl">
    &#10132; <em style="font-style:italic; color:var(--terracotta-2); font-weight:700;">Reference set</em> &mdash; controlled comparison basis, not final clinical validation.
  </div>

  <div class="ftr">
    <div>SENTINEL<em style="font-style:italic; color:var(--terracotta-2);">AI</em> &nbsp;|&nbsp; 03 JUN 2026</div>
    <div class="rule"></div>
    <div style="color:var(--terracotta-2);">9 / 13</div>
  </div>
</section>
